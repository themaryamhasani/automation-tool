{
  "manifest_version": 3,
  "name": "Automation Tool Recorder",
  "description": "Record, inspect, replay, save and run Playwright tests in Automation Tool.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Automation Tool Recorder"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "debugger",
    "downloads",
    "offscreen",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "commands": {
    "record": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open and record the current tab"
    },
    "inspect": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Inspect a locator in the current tab"
    }
  }
}
