{
  "openapi": "3.0.3",
  "info": {
    "title": "Automation Tool API",
    "version": "4.1.0",
    "description": "Platform API for scheduling, running, and reporting automated quality checks across IS, CDE, Git, and ZIP sources."
  },
  "servers": [{ "url": "/", "description": "Same origin" }],
  "tags": [
    { "name": "Auth" },
    { "name": "Chrome Recorder" },
    { "name": "Runs" },
    { "name": "Automation" },
    { "name": "Analytics" },
    { "name": "Pipeline" },
    { "name": "Ops" },
    { "name": "Platform" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Platform"],
        "summary": "Liveness",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Password login (may return 202 for 2FA challenge)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["identity", "password"],
                "properties": {
                  "identity": { "type": "string" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Session issued" },
          "202": { "description": "TOTP challenge required" }
        }
      }
    },
    "/api/auth/2fa/verify": {
      "post": {
        "tags": ["Auth"],
        "summary": "Complete TOTP challenge",
        "responses": { "200": { "description": "Session issued" } }
      }
    },
    "/api/auth/sso/start": {
      "get": {
        "tags": ["Auth"],
        "summary": "Begin OIDC SSO redirect",
        "responses": { "302": { "description": "Redirect to IdP" } }
      }
    },
    "/api/extension/pairings": {
      "post": {
        "tags": ["Chrome Recorder"],
        "summary": "Create a short-lived, single-use extension pairing code",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "201": { "description": "Pairing code issued for the signed-in user's current projects" },
          "401": { "description": "Interactive web session required" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/extension/pairings/exchange": {
      "post": {
        "tags": ["Chrome Recorder"],
        "summary": "Exchange a pairing code once for an extension access and refresh token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["pairingCode", "deviceId"],
            "properties": {
              "pairingCode": { "type": "string", "writeOnly": true },
              "deviceId": { "type": "string", "minLength": 16, "maxLength": 200 },
              "deviceName": { "type": "string", "maxLength": 120 }
            }
          } } }
        },
        "responses": {
          "201": { "description": "Paired extension session created" },
          "400": { "description": "Invalid, expired, or consumed code" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/extension/auth/refresh": {
      "post": {
        "tags": ["Chrome Recorder"],
        "summary": "Rotate extension access and refresh credentials",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["refreshToken", "deviceId"],
            "properties": {
              "refreshToken": { "type": "string", "writeOnly": true },
              "deviceId": { "type": "string", "minLength": 16, "maxLength": 200 }
            }
          } } }
        },
        "responses": {
          "200": { "description": "Credentials rotated" },
          "401": { "description": "Refresh credential expired, revoked, rotated, or invalid" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/extension/sessions": {
      "get": {
        "tags": ["Chrome Recorder"],
        "summary": "List extension devices for the signed-in user",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Extension sessions (without token material)" } }
      }
    },
    "/api/extension/sessions/{id}": {
      "delete": {
        "tags": ["Chrome Recorder"],
        "summary": "Revoke one extension device",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Device revoked" },
          "404": { "description": "Device not found" }
        }
      }
    },
    "/api/extension/auth/session": {
      "delete": {
        "tags": ["Chrome Recorder"],
        "summary": "Revoke the calling extension session",
        "security": [{ "extensionAccessToken": [] }],
        "responses": { "204": { "description": "Extension session revoked" } }
      }
    },
    "/api/files/validate": {
      "post": {
        "tags": ["Chrome Recorder"],
        "summary": "Parse and validate Playwright source without executing it",
        "security": [{ "sessionCookie": [] }, { "bearerAuth": [] }, { "apiToken": [] }, { "extensionAccessToken": [] }],
        "responses": {
          "200": { "description": "Validation result, including content-free issue details when unsafe" }
        }
      }
    },
    "/api/files/upsert": {
      "put": {
        "tags": ["Chrome Recorder"],
        "summary": "Atomically create or update a test file by project, folder, and file name",
        "security": [{ "sessionCookie": [] }, { "bearerAuth": [] }, { "apiToken": [] }, { "extensionAccessToken": [] }],
        "responses": {
          "200": { "description": "Existing file updated" },
          "201": { "description": "New file created" },
          "409": { "description": "Expected revision is stale" },
          "422": { "description": "Source validation failed" }
        }
      }
    },
    "/api/runs": {
      "get": {
        "tags": ["Runs"],
        "summary": "List runs",
        "security": [{ "sessionCookie": [] }, { "bearerAuth": [] }, { "apiToken": [] }],
        "responses": { "200": { "description": "Paged runs" } }
      },
      "post": {
        "tags": ["Runs"],
        "summary": "Queue a run (single create-run path)",
        "security": [{ "sessionCookie": [] }, { "bearerAuth": [] }, { "apiToken": [] }],
        "responses": { "201": { "description": "Run created" } }
      }
    },
    "/api/projects/{projectId}/suites": {
      "get": {
        "tags": ["Automation"],
        "summary": "List test suites",
        "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Suites" } }
      }
    },
    "/api/analytics/flaky": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Flaky test stats",
        "responses": { "200": { "description": "Paged flaky targets" } }
      }
    },
    "/api/analytics/runs/compare": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Compare two runs",
        "parameters": [
          { "name": "leftId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "rightId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": { "200": { "description": "Diff summary" } }
      }
    },
    "/api/runs/{id}/delta": {
      "get": {
        "tags": ["Runs"],
        "summary": "Delta vs previous same-target run (regression / still-fail / fixed)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "baselineId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": { "200": { "description": "Classified test delta" } }
      }
    },
    "/api/pipeline/gate": {
      "get": {
        "tags": ["Pipeline"],
        "summary": "CI quality gate check by project + commit SHA",
        "parameters": [
          { "name": "projectId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "commitSha", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Gate passed" },
          "409": { "description": "Gate failed" }
        }
      }
    },
    "/api/ops/snapshot": {
      "get": {
        "tags": ["Ops"],
        "summary": "Operations snapshot (queue, fleet, CDE)",
        "responses": { "200": { "description": "Snapshot" } }
      }
    },
    "/api/ops/events": {
      "get": {
        "tags": ["Ops"],
        "summary": "SSE stream of operations snapshots",
        "responses": { "200": { "description": "text/event-stream" } }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["Platform"],
        "summary": "This OpenAPI document",
        "responses": { "200": { "description": "OpenAPI 3 JSON" } }
      }
    },
    "/api/docs/runbook": {
      "get": {
        "tags": ["Platform"],
        "summary": "Production runbook (Markdown)",
        "responses": { "200": { "description": "Markdown" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "automation_session" },
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "apiToken": { "type": "apiKey", "in": "header", "name": "X-Api-Token" },
      "extensionAccessToken": { "type": "http", "scheme": "bearer", "description": "Short-lived eat_ extension access token" }
    }
  }
}
